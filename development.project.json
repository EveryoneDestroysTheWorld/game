{
  "name": "Everyone Destroys the World (Dev): Turf War",
  "globIgnorePaths": ["**/*.production.lua", "**/*.staging.lua", "**/*.development.lua"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Client": {
        "$path": "src/ReplicatedStorage/Client"
      },
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared",
        "Packages": {
          "$path": "Packages"
        }
      }
    },
    "Workspace": {
      "$path": "src/Workspace",
      "$ignoreUnknownInstances": true
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },
    "ServerStorage": {
      "$path": "src/ServerStorage",
      "Packages": {
        "$path": "ServerPackages"
      },
      "PlaceMap": {
        "$path": "src/ServerStorage/PlaceMap.development.lua"
      }
    },
    "StarterPlayer": {
      "$path": "src/StarterPlayer"
    }
  }
}